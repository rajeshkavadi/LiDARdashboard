  };

  DemViewer.prototype._ramp = function (t, out, i) {
    var k = 0;
    while (k < COLOR_STOPS.length - 2 && t > COLOR_STOPS[k + 1][0]) k++;
    var a = COLOR_STOPS[k];
    var b = COLOR_STOPS[k + 1];
    var f = (t - a[0]) / (b[0] - a[0]);
