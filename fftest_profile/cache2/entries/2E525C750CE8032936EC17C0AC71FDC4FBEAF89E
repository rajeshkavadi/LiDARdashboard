/* Incremental DEM terrain viewer (Three.js r128).
 *
 * The DEM service sends a full grid once and then dirty rectangles.  Terrain
 * is drawn as 32x32-cell block meshes: only blocks touched by a patch are
 * rebuilt, so the visualization stays independent of the full raster size.
 *
 * Message layout: see webapp/protocol.py ("LVD1").
 */
(function (global) {
  'use strict';

  var DEM_MAGIC = 0x3144564c; // "LVD1"
  var HEADER_SIZE = 56;      // envelope (8) + fixed DEM header (48)
  var BLOCK = 32;
  var MAX_BLOCKS = 4096;

  var COLOR_STOPS = [
    [0.00, 0.15, 0.29, 0.86],
    [0.25, 0.13, 0.83, 0.93],
    [0.50, 0.13, 0.77, 0.37],
    [0.75, 0.92, 0.70, 0.03],
    [1.00, 0.94, 0.27, 0.27]
  ];

  function DemViewer(canvas, options) {
    options = options || {};
    this.canvas = canvas;
    this.onStats = options.onStats || function () {};
    this.active = false;
    this.width = 0;
    this.height = 0;
    this.originX = 0;
    this.originY = 0;
    this.resolution = 0.5;
    this.nodata = -9999;
    this.heights = null;
    this.stats = {};
    this.blocks = {};
    this.dirty = {};
    this.userMoved = false;
    this._fitted = false;
    this._renderFrames = 0;
    this._renderWindowStart = performance.now();

    this._init();
    this._loop();
