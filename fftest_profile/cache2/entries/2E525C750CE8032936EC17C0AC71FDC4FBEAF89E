  };

  DemViewer.prototype.setActive = function (active) {
    this.active = active;
    if (active) {
      this.resize();
      this._renderFrames = 0;
      this._renderWindowStart = performance.now();
    }
  };

  DemViewer.prototype.resize = function () {
    var width = this.canvas.clientWidth;
    var height = this.canvas.clientHeight;
    if (!width || !height) return;
    this.camera.aspect = width / height;
    this.camera.updateProjectionMatrix();
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    this.renderer.setSize(width, height, false);
  };

  DemViewer.prototype.applyMessage = function (buffer) {
    if (!buffer || buffer.byteLength < 8) return false;
    var view = new DataView(buffer);
    if (view.getUint32(0, true) !== DEM_MAGIC) return false;
    var type = view.getUint8(4);
    if (type === 3) { this.reset(); return true; }
    if (buffer.byteLength < HEADER_SIZE) return false;

    var originX = view.getFloat64(8, true);
    var originY = view.getFloat64(16, true);
    var resolution = view.getFloat32(24, true);
    var gridWidth = view.getUint32(28, true);
    var gridHeight = view.getUint32(32, true);
    var x0 = view.getUint32(36, true);
    var y0 = view.getUint32(40, true);
    var w = view.getUint32(44, true);
    var h = view.getUint32(48, true);
    this.nodata = view.getFloat32(52, true);
    if (!w || !h || !gridWidth || !gridHeight) return false;
    if (HEADER_SIZE + w * h * 4 > buffer.byteLength) return false;
    var values = new Float32Array(buffer, HEADER_SIZE, w * h);

    if (type === 2) {
      this.width = gridWidth;
      this.height = gridHeight;
      this.originX = originX;
      this.originY = originY;
      this.resolution = resolution;
      this.heights = new Float32Array(this.width * this.height);
      this._fillNaN(this.heights);
      this._clearBlocks();
      this._markAllDirty();
    } else if (type === 1) {
      if (this.width !== gridWidth || this.height !== gridHeight ||
          !this.heights) return false;
      this.originX = originX;
      this.originY = originY;
      this.resolution = resolution;
    } else {
      return false;
    }

    if (x0 + w > this.width || y0 + h > this.height) return false;
    for (var r = 0; r < h; r++) {
      var dst = (y0 + r) * this.width + x0;
      var src = r * w;
      for (var c = 0; c < w; c++) {
        this.heights[dst + c] = values[src + c];
      }
    }
    this._markDirty(x0, y0, w, h);
    if (!this._fitted) this._fit();
    this._emitStats();
    return true;
  };

  DemViewer.prototype._fillNaN = function (array) {
    for (var i = 0; i < array.length; i++) array[i] = NaN;
  };

  DemViewer.prototype._markAllDirty = function () {
    var bxMax = Math.ceil(this.width / BLOCK);
    var byMax = Math.ceil(this.height / BLOCK);
    for (var by = 0; by < byMax; by++) {
      for (var bx = 0; bx < bxMax; bx++) {
        this.dirty[bx + ',' + by] = true;
      }
    }
    this._initialDirty = true;
  };

  DemViewer.prototype._markDirty = function (x0, y0, w, h) {
    // One-cell margin: triangles use the neighbouring cell, so a block on the
    // patch border must be rebuilt as well.
    var x1 = Math.max(0, x0 - 1);
    var y1 = Math.max(0, y0 - 1);
    var x2 = Math.min(this.width - 1, x0 + w);
    var y2 = Math.min(this.height - 1, y0 + h);
    var bxMax = Math.floor(x2 / BLOCK);
    var byMax = Math.floor(y2 / BLOCK);
    var bxMin = Math.floor(x1 / BLOCK);
    var byMin = Math.floor(y1 / BLOCK);
    for (var by = byMin; by <= byMax; by++) {
      for (var bx = bxMin; bx <= bxMax; bx++) {
        this.dirty[bx + ',' + by] = true;
      }
    }
  };

  DemViewer.prototype.reset = function () {
    this.heights = null;
    this.width = 0;
    this.height = 0;
    this._clearBlocks();
    this._fitted = false;
    this.userMoved = false;
    this._emitStats();
  };

  DemViewer.prototype._clearBlocks = function () {
    for (var key in this.blocks) {
      if (!this.blocks.hasOwnProperty(key)) continue;
      var mesh = this.blocks[key];
      this.terrain.remove(mesh);
      mesh.geometry.dispose();
      mesh.material.dispose();
    }
    this.blocks = {};
    this.dirty = {};
  };

  DemViewer.prototype._range = function () {
    var lo = Infinity;
    var hi = -Infinity;
    if (this.heights) {
      for (var i = 0; i < this.heights.length; i++) {
        var z = this.heights[i];
        if (!isFinite(z)) continue;
        if (z < lo) lo = z;
        if (z > hi) hi = z;
      }
    }
    if (!isFinite(lo) || !isFinite(hi)) {
      lo = this.stats.min_elevation;
      hi = this.stats.max_elevation;
