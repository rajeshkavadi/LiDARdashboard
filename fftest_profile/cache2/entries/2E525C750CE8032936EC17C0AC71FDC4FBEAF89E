  DemViewer.prototype._buildBlock = function (bx, by) {
    var key = bx + ',' + by;
    var range = this._range();
    if (!range || !this.heights) return;
    var positions = [];
    var colors = [];
    var c0 = bx * BLOCK;
    var r0 = by * BLOCK;
    var c1 = Math.min(this.width - 1, c0 + BLOCK);
    var r1 = Math.min(this.height - 1, r0 + BLOCK);
    var res = this.resolution;
    var invSpan = 1 / (range.max - range.min);

    function addCell(r, c) {
      var z00 = this.heights[r * this.width + c];
      var z10 = this.heights[r * this.width + c + 1];
      var z01 = this.heights[(r + 1) * this.width + c];
      var z11 = this.heights[(r + 1) * this.width + c + 1];
      if (!isFinite(z00) || !isFinite(z10) || !isFinite(z01) || !isFinite(z11)) return;
      var x0 = this.originX + (c + 0.5) * res;
      var x1 = this.originX + (c + 1.5) * res;
      var y0 = this.originY + (r + 0.5) * res;
      var y1 = this.originY + (r + 1.5) * res;
      var quad = [
        [x0, y0, z00], [x1, y0, z10], [x1, y1, z11],
        [x0, y0, z00], [x1, y1, z11], [x0, y1, z01]
      ];
      for (var q = 0; q < quad.length; q++) {
        var p = quad[q];
        positions.push(p[0], p[1], p[2]);
        var t = (p[2] - range.min) * invSpan;
        if (t < 0) t = 0; else if (t > 1) t = 1;
        var color = [0, 0, 0];
        this._ramp(t, color, 0);
        colors.push(color[0], color[1], color[2]);
      }
    }

    for (var r = r0; r < r1; r++) {
      for (var c = c0; c < c1; c++) {
        addCell.call(this, r, c);
      }
    }

    if (this.blocks[key]) {
      this.terrain.remove(this.blocks[key]);
      this.blocks[key].geometry.dispose();
      this.blocks[key].material.dispose();
      delete this.blocks[key];
