    this.controls.target.set(cx, cy, cz);
    this.camera.position.set(cx + extent * 0.55, cy - extent * 0.85, cz + extent * 0.6);
    this.camera.up.set(0, 0, 1);
    this.camera.lookAt(cx, cy, cz);
    this.controls.update();
